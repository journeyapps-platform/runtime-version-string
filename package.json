{
  "name": "@ja-platform/runtime-version-string",
  "version": "1.1.0",
  "author": "JourneyApps",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && rm -rf ./dist",
    "test": "vitest run",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "test:watch": "vitest",
    "changeset": "changeset",
    "release": "pnpm build && pnpm changeset publish",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx}\""
  },
  "dependencies": {
    "semver": "7.8.5"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "@types/semver": "7.8.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "@changesets/cli": "^3.0.3"
  },
  "description": "Parse, validate and serialize Journey Runtime version strings.",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=12 <13"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/journeyapps-platform/runtime-version-string.git"
  }
}
